# ========================================
# HOW TO USE
# ========================================
# cp .env.example .env.local   then fill in the values below.
# .env.local is git-ignored. NEVER commit real values; only this template belongs in git.
# Full explanation: docs/SETUP.md

# ========================================
# REQUIRED BY THE APP
# Supabase Dashboard → Project Settings → API
# ========================================

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. It is shipped to every browser, so it is NOT a secret:
# all data protection comes from Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ========================================
# SERVER / SCRIPTS ONLY - SECRET
# Bypasses RLS completely. Never prefix with NEXT_PUBLIC_, never use in client code.
# Currently only used by scripts/setup-demo-accounts.js.
# ========================================

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# DEMO ACCOUNTS - DEV/DEMO PROJECTS ONLY
# Used by scripts/setup-demo-accounts.js. Set ALLOW_DEMO_SEED=true only on a
# throwaway/dev project. Generate passwords, e.g.: openssl rand -base64 18
# ========================================

ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# ========================================
# OPTIONAL - DIRECT DATABASE ACCESS (psql / Supabase CLI)
# Supabase Dashboard → Project Settings → Database. Not read by the app.
# ========================================

# POSTGRES_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
