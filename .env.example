# ========================================
# HOW TO USE
# ========================================
# cp .env.example .env.local   then fill in the values below.
# .env.local is git-ignored. NEVER commit real values; only this template belongs in git.
# Full explanation: docs/SETUP.md

# ========================================
# REQUIRED BY THE APP
# Supabase Dashboard → Project Settings → API
# ========================================

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. It is shipped to every browser, so it is NOT a secret:
# all data protection comes from Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ========================================
# SERVER / SCRIPTS ONLY - SECRET
# Bypasses RLS completely. Never prefix with NEXT_PUBLIC_, never use in client code.
# Currently only used by scripts/setup-demo-accounts.js.
# ========================================

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# DEMO ACCOUNTS - DEV/DEMO PROJECTS ONLY
# Used by scripts/setup-demo-accounts.js. Set ALLOW_DEMO_SEED=true only on a
# throwaway/dev project. Generate passwords, e.g.: openssl rand -base64 18
# ========================================

ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# ========================================
# IMPORT FROM THE LEBU-FORM REGISTER (scripts/import-lebu-form.mjs) - SECRET
# Set ALLOW_MEMBER_IMPORT=true only while importing. The endpoint is the Apps Script
# /exec URL from lebu-form's config.js; the passcode is the office (staff) passcode.
# ========================================

ALLOW_MEMBER_IMPORT=false
# LEBU_FORM_ENDPOINT=https://script.google.com/macros/s/…/exec
# LEBU_FORM_PASSCODE=

# ========================================
# DATABASE MIGRATIONS - SECRET (npm run db:up / db:down / db:status / db:new)
# Your LOCAL database only (Docker or `npx supabase start`), for writing and testing migrations.
# Staging and production are migrated only by the Deploy workflow (docs/ENGINEERING.md).
# Not read by the app.
# ========================================

# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
