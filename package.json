{
  "name": "lkhc-church-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "local:start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local.mjs start",
    "local:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local.mjs reset",
    "local:stop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local.mjs stop",
    "local:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local.mjs status",
    "db:up": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local node_modules/dbmate/dist/cli.js --no-dump-schema --migrations-table dbmate.schema_migrations up",
    "db:down": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local node_modules/dbmate/dist/cli.js --no-dump-schema --migrations-table dbmate.schema_migrations rollback",
    "db:status": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local node_modules/dbmate/dist/cli.js --no-dump-schema --migrations-table dbmate.schema_migrations status",
    "db:new": "node node_modules/dbmate/dist/cli.js new",
    "db:test": "bash db/tests/roundtrip.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "import:lebu-form": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-lebu-form.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
